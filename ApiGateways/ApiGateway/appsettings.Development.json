{
  "SwaggerAggregator": {
    "Services": [
      {
        "Name": "orders-service",
        "DisplayName": "Orders Service",
        "SwaggerUrl": "http://orders-service/swagger/v1/swagger.json"
      },
      {
        "Name": "inventory-service",
        "DisplayName": "Inventory Service",
        "SwaggerUrl": "http://inventory-service/swagger/v1/swagger.json"
      },
      {
        "Name": "users-service",
        "DisplayName": "Users Service",
        "SwaggerUrl": "http://users-service/swagger/v1/swagger.json"
      }
    ]
  },
  "RateLimiting": {
    "GeneralRules": [
      {
        "*Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },
  "JwtSettings": {
    "RsaPublicKey": "-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----",
    "Issuer": "UserApi",
    "Audiences": [ "UserClient", "RecipeClient", "RatingClient" ]
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/users" },
          {
            "RequestHeader": "X-internal-Source",
            "Set": "ApiGateway"
          }
        ]
      },
      "recipes-route": {
        "ClusterId": "recipes-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/recipes/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recipes" }
        ]
      },
      "ratings-route": {
        "ClusterId": "ratings-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/ratings/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ratings" }
        ]
      },
      "recommendations-route": {
        "ClusterId": "recommendations-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/recommendations" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notifications" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "users-primary": {
            "Address": "https://localhost:7296"
          }
        }
      },
      "recipes-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "recipes-primary": {
            "Address": "https://localhost:7037"
          }
        }
      },
      "ratings-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "ratings-primary": {
            "Address": "https://localhost:7154"
          }
        }
      },
      "recommendations-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "recommendations-primary": {
            "Address": "https://localhost:7193"
          }
        }
      },
      "notifications-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "notifications-primary": {
            "Address": "https://localhost:7073"
          }
        }
      }
    }
  },
  "PublicRoutes": [
    "GET /api/users/{id}/basic",
    "POST /api/users/login",
    "POST /api/users/register",
    "GET /api/users/{id}/preferences",

    "GET /api/recipes",
    "POST /api/recipes",
    "GET /api/recipes/{id}",
    "PUT /api/recipes/{id}/rating",
    "GET /api/recipes/by-ingredients",
    "GET /api/recipes/get-only-recipe/{id}",
    "GET /api/recipes/search",
    "GET /api/recipes/trending",
    "GET /api/recipes/user/{userId}",

    "GET /api/ratings/recipe/{recipeId}",
    "GET /api/ratings/recipe/{recipeId}/average",
    "GET /api/ratings/user/{userId}",
    "GET /api/ratings/user/{userId}/recipe/{recipeId}",

    "POST /api/recommendations/by-ingredients",
    "GET /api/recommendations/similar/{recipeId}",
    "GET /api/recommendations/trending",
    "GET /api/recommendations/user/{userId}",

    "POST /api/notifications",
    "POST /api/notifications/rating-received"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
