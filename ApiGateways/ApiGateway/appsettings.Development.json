{
  "SwaggerAggregator": {
    "GatewayPublicUrl": "",
    "Services": [
      {
        "Name": "users-service",
        "DisplayName": "Users Service",
        "SwaggerUrl": "https://localhost:7296/swagger/v1/swagger.json"
      },
      {
        "Name": "recipe-service",
        "DisplayName": "Recipe Service",
        "SwaggerUrl": "https://localhost:7037/swagger/v1/swagger.json"
      },
      {
        "Name": "rating-service",
        "DisplayName": "Rating Service",
        "SwaggerUrl": "https://localhost:7154/swagger/v1/swagger.json"
      },
      {
        "Name": "recommendation-service",
        "DisplayName": "Recommendation Service",
        "SwaggerUrl": "https://localhost:7193/swagger/v1/swagger.json"
      },
      {
        "Name": "notification-service",
        "DisplayName": "Notification Service",
        "SwaggerUrl": "https://localhost:7073/swagger/v1/swagger.json"
      }
    ]
  },
  "RateLimiting": {
    "GeneralRules": [
      {
        "*Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },
  "JwtSettings": {
    "RsaPublicKey": "-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----",
    "Issuer": "UserApi",
    "Audiences": [ "UserClient", "RecipeClient", "RatingClient", "NotificationClient" ]
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "recipes-route": {
        "ClusterId": "recipes-cluster",
        "Match": {
          "Path": "/api/recipes/{**catch-all}"
        }
      },
      "ratings-route": {
        "ClusterId": "ratings-cluster",
        "Match": {
          "Path": "/api/ratings/{**catch-all}"
        }
      },
      "recommendations-route": {
        "ClusterId": "recommendations-cluster",
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "users-primary": {
            "Address": "https://localhost:7296"
          }
        }
      },
      "recipes-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "recipes-primary": {
            "Address": "https://localhost:7037"
          }
        }
      },
      "ratings-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "ratings-primary": {
            "Address": "https://localhost:7154"
          }
        }
      },
      "recommendations-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "recommendations-primary": {
            "Address": "https://localhost:7193"
          }
        }
      },
      "notifications-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notifications-primary": {
            "Address": "https://localhost:7073"
          }
        }
      }
    }
  },
  "HealthChecksUi": {
    "HealthChecks": [
      {
        "Name": "User Service",
        "Uri": "https://localhost:7296/health"
      },
      {
        "Name": "Recipe Service",
        "Uri": "https://localhost:7037/health"
      },
      {
        "Name": "Rating Service",
        "Uri": "https://localhost:7154/health"
      },
      {
        "Name": "Recommendation Service",
        "Uri": "https://localhost:7193/health"
      },
      {
        "Name": "Notification Service",
        "Uri": "https://localhost:7073/health"
      }
    ],
    "EvaluationTimeInSeconds": 30,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "PublicRoutes": [
    "GET /api/users/{id}/basic",
    "POST /api/users/login",
    "POST /api/users/register",
    "GET /api/users/{id}/preferences",

    "GET /api/recipes",
    "POST /api/recipes",
    "GET /api/recipes/{id}",
    "PUT /api/recipes/{id}/rating",
    "GET /api/recipes/by-ingredients",
    "GET /api/recipes/get-only-recipe/{id}",
    "GET /api/recipes/search",
    "GET /api/recipes/trending",
    "GET /api/recipes/user/{userId}",

    "GET /api/ratings/recipe/{recipeId}",
    "GET /api/ratings/recipe/{recipeId}/average",
    "GET /api/ratings/user/{userId}",
    "GET /api/ratings/user/{userId}/recipe/{recipeId}",

    "POST /api/recommendations/by-ingredients",
    "GET /api/recommendations/similar/{recipeId}",
    "GET /api/recommendations/trending",
    "GET /api/recommendations/user/{userId}",

    "POST /api/notifications",
    "POST /api/notifications/rating-received",

    "GET /health",
    "GET /health-ui",
    "GET /health-ui-api",
    "GET /swagger",
    "GET /swagger/{**rest}",
    "GET /ui/resources/{**rest}", 
    "GET /favicon.ico"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug",
      "System.Net.Http": "Debug"
    }
  }
}
